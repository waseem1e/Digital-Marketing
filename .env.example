# Copy this file to .env and fill it in. Never commit .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
BASE_URL=http://localhost:3000
GOOGLE_ADS_API_VERSION=v25
# Optional. Developer tokens were retired by Google in September 2026, so leave this empty.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional. The server refuses to create a campaign above this daily budget, in AUD.
MAX_DAILY_BUDGET=
